# docfind-reports: every setting is an environment variable. Copy this file to
# .env beside the binary (or name it with -env-file) and fill in what you use.
# Real variables in the environment win over this file unless -env-file-wins
# is given. Never commit the filled-in copy.

# ---------------------------------------------------------------- reporting database
# The MySQL or MariaDB the reports in the -reports folder read. Give it an
# account that can only read (GRANT SELECT): the reports are refused unless
# they are a single SELECT, and this is the second half of that promise.
# Without it the dashboard says reporting is not configured; the builder,
# which brings its own connections, still works.
DOCFIND_DB_HOST=127.0.0.1:3306
DOCFIND_DB_USER=reports_ro
DOCFIND_DB_PASSWORD=change-me
DOCFIND_DB_NAME=reports_demo
# Or a whole connection string, which wins over the four above:
#DOCFIND_DB_DSN=reports_ro:change-me@tcp(127.0.0.1:3306)/reports_demo?charset=utf8mb4

# ---------------------------------------------------------------- other servers
# A report whose file says "-- source: finance" reads the SQL Server named
# here instead, one variable per name. SQL Server only, on an account that can
# only read. A report on a server that is not configured is left off the
# dashboard and the permission screen.
#DOCFIND_SOURCE_FINANCE_DSN=sqlserver://reader:change-me@db.example.com:1433?database=books

# ---------------------------------------------------------------- report builder
# The builder's connections may reach the network but not this machine itself
# or a link-local address. Hosts listed here are accepted whatever they resolve
# to, comma separated: a database on this same machine, say.
#DOCFIND_ALLOWED_HOSTS=127.0.0.1

# ---------------------------------------------------------------- snapshots
# Report pages, charts and monthly summaries are answered from their last copy
# at once and refreshed behind it once they are older than this many seconds,
# 60 to 300.
#DOCFIND_REPORT_REFRESH_SECONDS=120

# ---------------------------------------------------------------- accounts database
# Optional. Without it accounts are kept in the accounts file (-users) and the
# audit trail goes to the log only. With it, accounts, the audit trail and the
# settings live in PostgreSQL; the schema is created and upgraded on start.
#DOCFIND_PG_HOST=127.0.0.1
#DOCFIND_PG_PORT=5432
#DOCFIND_PG_USER=reports
#DOCFIND_PG_PASSWORD=change-me
#DOCFIND_PG_DATABASE=reports
# disable | require | verify-ca | verify-full
#DOCFIND_PG_SSLMODE=disable
# Queries slower than this many milliseconds are logged, in either database.
#DOCFIND_SLOW_QUERY_MS=500

# ---------------------------------------------------------------- HTTPS
# Serve TLS directly. Leave unset behind a reverse proxy that terminates TLS.
# Passkeys and the installed app need a secure page.
#DOCFIND_TLS_CERT=/etc/reports/fullchain.pem
#DOCFIND_TLS_KEY=/etc/reports/privkey.pem

# ---------------------------------------------------------------- passkeys
# The host name passkeys are bound to. A passkey belongs to this name for
# good: change it and every registered passkey stops working.
#DOCFIND_PASSKEY_RPID=reports.example.com
# The origins pages are served from, comma separated, each https on that host.
#DOCFIND_PASSKEY_ORIGINS=https://reports.example.com

# ---------------------------------------------------------------- sign-in codes
# Two-step sign-in by email: a mailbox to send the codes from. Port 465 is TLS
# from the start, 587 is STARTTLS; nothing is sent over a plain connection.
#DOCFIND_SMTP_HOST=smtp.example.com
#DOCFIND_SMTP_PORT=465
#DOCFIND_SMTP_USERNAME=codes@example.com
#DOCFIND_SMTP_PASSWORD=
#DOCFIND_SMTP_FROM=codes@example.com
# Two-step sign-in by SMS, and resetting a forgotten password by SMS. The
# panel's REST API (the default URL is Asanak's).
#DOCFIND_SMS_URL=
#DOCFIND_SMS_USERNAME=
#DOCFIND_SMS_PASSWORD=
#DOCFIND_SMS_API_KEY=
# The sender number, in international form without the plus.
#DOCFIND_SMS_FROM=

# ---------------------------------------------------------------- logs
# Default: a logs folder beside the accounts file.
#DOCFIND_LOG_DIR=
#DOCFIND_LOG_KEEP_DAYS=30
#DOCFIND_LOG_MAX_DAY_MB=200
